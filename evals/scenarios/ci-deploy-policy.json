{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Artifacts",
      "Effect": "Allow",
      "Action": ["s3:*Object*", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::acme-build-artifacts", "arn:aws:s3:::acme-build-artifacts/*"]
    },
    {
      "Sid": "Images",
      "Effect": "Allow",
      "Action": ["ecr:Get*", "ecr:BatchGet*", "ecr:PutImage", "ecr:InitiateLayerUpload", "ecr:UploadLayerPart", "ecr:CompleteLayerUpload"],
      "Resource": "arn:aws:ecr:eu-west-1:111122223333:repository/acme-api"
    },
    {
      "Sid": "Deploy",
      "Effect": "Allow",
      "Action": ["lambda:Update*", "lambda:Get*", "lambda:PublishVersion"],
      "Resource": "arn:aws:lambda:eu-west-1:111122223333:function:acme-api-*"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": "logs:*",
      "Resource": "*"
    },
    {
      "Sid": "PassExecutionRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::111122223333:role/acme-api-execution"
    }
  ]
}
