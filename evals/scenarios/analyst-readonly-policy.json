{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadData",
      "Effect": "Allow",
      "Action": [
        "s3:GetObjekt",
        "s3:GetObjectVersion",
        "s3:ListBucket",
        "athena:StartQueryExecution",
        "athena:GetQueryResults",
        "athena:GetQueryExecutoin",
        "glue:GetTable",
        "glue:GetTables",
        "glue:GetDatabase"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NoDestructiveS3",
      "Effect": "Deny",
      "NotAction": ["s3:Get*", "s3:List*", "s3:Describe*"],
      "Resource": "arn:aws:s3:::acme-datalake/*"
    }
  ]
}
